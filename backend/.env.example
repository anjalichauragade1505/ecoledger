# Copy this file to .env for LOCAL development only.
# On Render, you will NOT upload this file — you paste these as
# environment variables in the Render dashboard instead (see DEPLOY.md).

# ── Admin login (change these to your own values) ──────────────────────────
ADMIN_EMAIL=admin@ecoledger.com
ADMIN_PASSWORD=change-this-password

# ── JWT secret — any long random string, keep it secret ────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ── Google Drive ─────────────────────────────────────────────────────────
# The ID of the Drive folder EcoLedger will store city data in.
# Find it in the folder's URL: drive.google.com/drive/folders/<THIS_PART>
GDRIVE_ROOT_FOLDER_ID=

# EITHER paste the full service account JSON key as one line here (used on
# Render), OR leave this blank and put the key file locally and set
# GDRIVE_SERVICE_ACCOUNT_FILE instead (used for local dev). See DEPLOY.md.
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_SERVICE_ACCOUNT_FILE=service_account.json

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of frontend URLs allowed to call this API.
# Use * during setup/testing, then lock it down to your real frontend URL.
CORS_ORIGINS=*
